# Copy to .env for local development. Never commit real secrets (docs/64).

NODE_ENV=development
SHOO_ENV=local

# --- Operational PostgreSQL (docker-compose service `postgres`) -------------
# Runtime (request-serving) role: not the table owner, RLS applies.
DATABASE_URL=postgres://shoo_app:shoo_dev_password@localhost:5432/shoo
# Migration/maintenance role: owns tables, isolated from request traffic.
DATABASE_MIGRATION_URL=postgres://shoo_migrator:shoo_dev_password@localhost:5432/shoo
DATABASE_POOL_MAX=10

# --- Shoo API ---------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8787
API_PUBLIC_URL=http://localhost:8787
LOG_LEVEL=info

# --- Shoo Web ---------------------------------------------------------------
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8787/v1

# --- Shoo Local -------------------------------------------------------------
# Directory holding the encrypted local SQLite store.
SHOO_LOCAL_DATA_DIR=./.data/local
# CI/headless key provider fallback (see packages/local-store/README.md).
# Leave unset on developer machines so the OS vault is used.
# SHOO_LOCAL_KEY_PROVIDER=file
# SHOO_LOCAL_KEY_FILE=./.data/local/dev-key.json

# --- Identity (Clerk adapter) ----------------------------------------------
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- Embedding provider -----------------------------------------------------
EMBEDDING_PROVIDER=none
EMBEDDING_MODEL=
EMBEDDING_DIMENSION=1536
