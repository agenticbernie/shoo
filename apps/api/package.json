{
  "name": "@shoo/api",
  "version": "0.1.0",
  "private": true,
  "description": "Shoo API and MCP gateway (Fastify modular monolith composition root).",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@shoo/application": "workspace:*",
    "@shoo/config": "workspace:*",
    "@shoo/contracts-http": "workspace:*",
    "@shoo/contracts-mcp": "workspace:*",
    "@shoo/observability": "workspace:*",
    "fastify": "catalog:"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "tsx": "4.23.12",
    "typescript": "5.9.3"
  }
}
