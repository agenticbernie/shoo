{
  "name": "@shoo/web",
  "version": "0.1.0",
  "private": true,
  "description": "Shoo Web UI (Next.js App Router) — talks to the Shoo API only, never to PostgreSQL.",
  "license": "Apache-2.0",
  "scripts": {
    "build": "next build",
    "dev": "next dev --port ${WEB_PORT:-3000}",
    "start": "next start",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf .next dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@shoo/contracts-http": "workspace:*",
    "@shoo/design-tokens": "workspace:*",
    "@shoo/ui": "workspace:*",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "typescript": "5.9.3"
  }
}
