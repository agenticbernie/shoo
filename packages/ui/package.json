{
  "name": "@shoo/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Shoo React component primitives built on semantic design tokens and typed view models.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@shoo/design-tokens": "workspace:*"
  },
  "peerDependencies": {
    "react": "catalog:"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "react": "catalog:",
    "typescript": "5.9.3"
  }
}
