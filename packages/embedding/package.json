{
  "name": "@shoo/embedding",
  "version": "0.1.0",
  "private": true,
  "description": "Embedding provider registry and vector descriptor types.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@shoo/application": "workspace:*"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
