{
  "name": "@shoo/application",
  "version": "0.1.0",
  "private": true,
  "description": "Use-case and port interfaces composed by Shoo apps.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@shoo/contracts-common": "workspace:*",
    "@shoo/contracts-events": "workspace:*",
    "@shoo/domain-shared": "workspace:*",
    "@shoo/domain-identity": "workspace:*",
    "@shoo/domain-continuity": "workspace:*",
    "@shoo/domain-memory": "workspace:*",
    "@shoo/domain-intelligence": "workspace:*",
    "@shoo/domain-platform": "workspace:*"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
