{
  "name": "@shoo/local-store",
  "version": "0.1.0",
  "private": true,
  "description": "Encrypted local SQLite store, AEAD payload envelope and OS-vault key provider.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist .turbo *.tsbuildinfo",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@napi-rs/keyring": "1.3.0",
    "@shoo/domain-shared": "workspace:*",
    "better-sqlite3": "13.0.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
